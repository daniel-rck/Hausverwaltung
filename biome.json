{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "extends": ["./biome.base.json"],
  "overrides": [
    { "includes": ["**/*.generated.ts"], "formatter": { "enabled": false } },
    { "includes": ["scripts/**"], "linter": { "rules": { "suspicious": { "noConsole": "off" } } } },
    {
      "includes": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
