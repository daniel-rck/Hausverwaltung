{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": { "newlinesBetween": false },
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    ".wrangler/**",
    "dev-dist/**",
    "bun.lock",
    "**/*.md",
    "**/*.generated.ts"
  ]
}
